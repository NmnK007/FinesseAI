# Copy to .env (ignored by git). Set both password fields consistently.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://finnese:replace-with-local-password@127.0.0.1:5432/finnese
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
# Both require NODE_ENV=development (npm run dev); production refuses both.
AUTH_DELIVERY=mailpit
ENABLE_DEMO=true
# No API key required.
# GOOGLE_API_KEY=

# Optional external extractive highlights; explicit per-question consent required.
COPILOT_EXTERNAL_ENABLED=false
# GEMINI_API_KEY=
# GEMINI_MODEL=your-authorized-gemini-model-id
