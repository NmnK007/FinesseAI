    "csv-parse": "7.0.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.454.0",
    "next": "15.5.29",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
